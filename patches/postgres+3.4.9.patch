diff --git a/node_modules/postgres/cf/src/connection.js b/node_modules/postgres/cf/src/connection.js
index 8e79170..d5b8a3f 100644
--- a/node_modules/postgres/cf/src/connection.js
+++ b/node_modules/postgres/cf/src/connection.js
@@ -237,7 +237,13 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
     q.onlyDescribe && (delete statements[q.signature])
     q.parameters = q.parameters || parameters
     q.prepared = q.prepare && q.signature in statements
-    q.describeFirst = q.onlyDescribe || (parameters.length && !q.prepared)
+    // scinvites patch (patches/postgres+3.4.9.patch): without prepared statements, only describe first when a value
+    // needs its server type to be serialized (lists, plain objects). Plain values go in one round trip, so a pooled
+    // connection is never left waiting on the client mid-query (Supabase transaction pooler + paused functions).
+    // scinvites patch: lists whose element type isn't known go as array literals that the server types from the
+    // query (e.g. `id = any($1)`, a text[] column), so they don't need describe first either.
+    !q.prepare && q.parameters.forEach((x, i) => !types[i] && Array.isArray(x) && (q.parameters[i] = arraySerializer(x, null, options, 0)))
+    q.describeFirst = q.onlyDescribe || (parameters.length && !q.prepared && (q.prepare || parameters.some((x, i) => !types[i] && x !== null && typeof x === 'object')))
     q.statement = q.prepared
       ? statements[q.signature]
       : { string, types, name: q.prepare ? statementId + statementCount++ : '' }
