# Copy to .env.local and fill in. Never commit real values.

# Public base URL of the site (no trailing slash)
APP_URL=http://localhost:3000

# Secret path for the owner area, e.g. a random word. Never link to it.
OWNER_PATH=change-me-studio

# bcrypt hash of the owner password: npm run hash-password -- 'the password'
OWNER_PASSWORD_HASH=

# Postgres connection. Local dev (npm run db:dev): the PGlite socket below.
# Production: Supabase pooler, transaction mode, port 6543.
DATABASE_URL=postgres://postgres@127.0.0.1:54329/postgres
# Local PGlite accepts one connection at a time
DB_POOL_MAX=1

# Supabase Storage (template artwork). Leave empty locally to use the in-memory adapter.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Resend (emails). Leave empty locally: emails are logged instead of sent.
RESEND_API_KEY=

# Shared secret for Vercel Cron calls
CRON_SECRET=change-me
